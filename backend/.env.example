# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=skin_lesion_db

# Security / JWT
JWT_SECRET=research-prototype-skin-lesion-secure-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Model Checkpoint Paths
UNET_MODEL_PATH=saved_models/unet/model1_selected_best.keras
CLASSIFICATION_MODEL_PATH=saved_models/efficientnet/best_three_class_model.keras

# Upload & File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server
PORT=8000
HOST=0.0.0.0

